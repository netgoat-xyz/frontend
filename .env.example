# NetGoat frontend-v2 environment contract.
# Copy to `.env` and fill in real values. Never commit `.env`.
# Validated at runtime by lib/env.ts — the app fails loudly on missing values.

# --- Core -------------------------------------------------------------------
MONGODB_URI=mongodb://127.0.0.1:27017/netgoat
# At least 16 characters. Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
# Public origin of this deployment, e.g. https://app.example.com
BETTER_AUTH_URL=http://localhost:3002
NEXT_PUBLIC_SITE_URL=http://localhost:3002

# --- Email ------------------------------------------------------------------
RESEND_APIKEY=
EMAIL_FROM=noreply@netgoat.app

# --- Control plane / edge agent API -----------------------------------------
EXTERNAL_API_URL=http://localhost:8787

# --- Cron -------------------------------------------------------------------
CRON_SECRET=

# --- Social providers (optional) --------------------------------------------
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITLAB_CLIENT_ID=
GITLAB_CLIENT_SECRET=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# --- Billing (optional, Polar) ----------------------------------------------
POLAR_ACCESS_TOKEN=
POLAR_SERVER=sandbox
POLAR_PRODUCT_ID_PRO_MONTHLY=
POLAR_PRODUCT_ID_PRO_YEARLY=
POLAR_PRODUCT_ID_ENTERPRISE_MONTHLY=
POLAR_PRODUCT_ID_ENTERPRISE_YEARLY=
POLAR_PRODUCT_PRO_MONTHLY_PRICE=
POLAR_PRODUCT_PRO_ANNUAL_PRICE=
POLAR_PRODUCT_ENTERPRISE_MONTHLY_PRICE=
POLAR_PRODUCT_ENTERPRISE_ANNUAL_PRICE=
